# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Login do painel
PAINEL_SENHA=
SESSAO_SEGREDO=

# Tokens dos endpoints (gere com: openssl rand -hex 32)
CAPTURA_TOKEN=
SENDFLOW_WEBHOOK_TOKEN=

# Opcional: domínios da página de captura, se ela chamar a API pelo navegador
# ex.: https://expert.traderdelite.net,https://www.expert.traderdelite.net
CAPTURA_ORIGENS=

# Monitor de tráfego (Cron da Vercel a cada 2 min — gere com: openssl rand -hex 32)
CRON_SECRET=

# Envio dos alertas do monitor por WhatsApp. Sem nada configurado, os alertas ficam só no painel.
#
# Opção 1 (recomendada) — Sendflow manda no grupo da equipe:
#   SENDFLOW_API_TOKEN + SENDFLOW_ACCOUNT_ID + SENDFLOW_ALERTAS_CAMPANHA_ID
#   A mensagem vai para TODOS os grupos da campanha indicada — use uma campanha
#   que só tenha o grupo da equipe (nunca a campanha dos leads).
# Opção 2 — Sendflow manda mensagem direta aos telefones cadastrados no lançamento:
#   SENDFLOW_API_TOKEN + SENDFLOW_ACCOUNT_ID (deixe SENDFLOW_ALERTAS_CAMPANHA_ID vazio)
SENDFLOW_API_TOKEN=
SENDFLOW_ACCOUNT_ID=
SENDFLOW_ALERTAS_CAMPANHA_ID=
# Só mude se o Sendflow informar outra URL de API
SENDFLOW_API_URL=
#
# Opção 3 — webhook genérico (Make/n8n): POST {telefone, mensagem, tipo, origem}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
