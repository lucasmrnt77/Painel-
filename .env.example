# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Login do painel
PAINEL_SENHA=
SESSAO_SEGREDO=

# Tokens dos endpoints (gere com: openssl rand -hex 32)
CAPTURA_TOKEN=
SENDFLOW_WEBHOOK_TOKEN=

# Opcional: domínios da página de captura, se ela chamar a API pelo navegador
# ex.: https://expert.traderdelite.net,https://www.expert.traderdelite.net
CAPTURA_ORIGENS=

# Monitor de tráfego (Cron da Vercel a cada 2 min — gere com: openssl rand -hex 32)
CRON_SECRET=

# Envio de WhatsApp dos alertas (opcional até a ferramenta ser definida).
# Sem isso, os alertas ficam só no painel.
# O painel faz POST {telefone, mensagem, tipo, origem} nessa URL.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
